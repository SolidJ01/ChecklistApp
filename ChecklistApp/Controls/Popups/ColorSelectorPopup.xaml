<?xml version="1.0" encoding="utf-8"?>

<controls:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ChecklistApp.Controls"
             x:Name="this"
             PopupMargin="15, 25"
             x:Class="ChecklistApp.Controls.ColorSelectorPopup">
    <Grid x:Name="Base" RowDefinitions="auto,70" RowSpacing="10" BindingContext="{x:Reference this}">
        <Grid.Resources>
            <LinearGradientBrush x:Key="SaturationBackgroundBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="White" Offset="0" />
                <GradientStop Color="{Binding Color}" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="LightnessBackgroundBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="Black" Offset="0" />
                <GradientStop Color="{Binding Color}" Offset="1" />
            </LinearGradientBrush>
        </Grid.Resources>
        <VerticalStackLayout Spacing="10"
                             Padding="10, 10, 10, 0">
            <Border Padding="15 ,0"
                    HeightRequest="50"
                    BackgroundColor="{Binding Color}">
                <Label Text="Custom Colour"
                       FontAttributes="Bold" 
                       TextColor="{StaticResource Text}"/>
            </Border>
            <controls:RoundedSlider Min="0" Max="1" Value="{Binding Hue}" BackgroundDimensions="{Binding BackgroundDimensions}" BackgroundImage="{Binding HueSelectorBackground}" />
            <controls:RoundedSlider Min="0" Max="1" Value="{Binding Saturation}" BackgroundBrush="{DynamicResource SaturationBackgroundBrush}" />
            <controls:RoundedSlider Min="0" Max="1" Value="{Binding Value}" BackgroundBrush="{DynamicResource LightnessBackgroundBrush}" />
        </VerticalStackLayout>
        <controls:ControlBar x:Name="ControlBar"
                             Grid.Row="1">
            <Grid ColumnDefinitions="50,*"
                  ColumnSpacing="10">
                <Button Text="&#xf060;" 
                        FontFamily="FontAwSolid"
                        Clicked="CloseButtonClicked" />
                <Button Grid.Column="1"
                        Text="Save" />
            </Grid>
        </controls:ControlBar>
    </Grid>
</controls:Popup>