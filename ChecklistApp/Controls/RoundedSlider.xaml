<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Name="this"
             x:Class="ChecklistApp.Controls.RoundedSlider">
    <Grid BindingContext="{x:Reference this}">
        <Border x:Name="Background" 
                Margin="10, 6"
                Background="{StaticResource ForegroundDarkBrush}"
                SizeChanged="OnBackgroundSizeChanged">
            <Image Source="{Binding BackgroundImage}" Aspect="Fill" IsOpaque="False" />
        </Border>
        <AbsoluteLayout x:Name="AbsoluteLayout"
                        HeightRequest="50">
            <Border x:Name="Slider"
                    BackgroundColor="{StaticResource Text}"
                    HeightRequest="50"
                    WidthRequest="20"
                    SizeChanged="OnLayoutSizeChanged">
                <Border.GestureRecognizers>
                    <PanGestureRecognizer PanUpdated="OnPanUpdated" />
                </Border.GestureRecognizers>
            </Border>
        </AbsoluteLayout>
    </Grid>
</ContentView>