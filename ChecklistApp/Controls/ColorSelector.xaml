<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ChecklistApp.Controls"
             xmlns:viewModel="clr-namespace:ChecklistApp.ViewModel"
             x:Name="this"
             x:Class="ChecklistApp.Controls.ColorSelector"
             x:DataType="controls:ColorSelector">
    <Border BindingContext="{x:Reference this}" 
           BackgroundColor="{StaticResource ForegroundDark}"
           Padding="10">
        <Grid x:Name="Layout"
              ColumnDefinitions="*,*,*,*,*"
              ColumnSpacing="10"
              RowSpacing="10"
              RowDefinitions="auto">
            
        </Grid>
    </Border>
</ContentView>
